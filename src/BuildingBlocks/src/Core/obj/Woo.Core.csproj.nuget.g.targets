    <Import Project="$(NuGetPackageRoot)microsoft.extensions.http.resilience\10.3.0\buildTransitive\net8.0\Microsoft.Extensions.Http.Resilience.targets" Condition="Exists('$(NuGetPackageRoot)microsoft.extensions.http.resilience\10.3.0\buildTransitive\net8.0\Microsoft.Extensions.Http.Resilience.targets')" />
